# Build directories
build/
build-*/
out/
cmake-build-*/

# Generated CMake files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
Makefile
*.cmake
!cmake/*.cmake
CMakeUserPresets.json

# Ninja
.ninja_deps
.ninja_log
build.ninja
rules.ninja

# MSVC / Visual Studio artifacts
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
*.pdb
*.ilk
*.obj
*.exe
*.exp
*.lib
*.idb
*.ipdb
*.iobj
*.pgi
*.pgd

# Runtime / packaging
*.dll
*.so
*.dylib

# IDE
.idea/
.vscode/
.cache/
compile_commands.json

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Build / debug log files (never ship; only useful during local builds)
*.log

# SDL3 fetched sources (FetchContent cache)
_third_party/
_external/

# Emscripten build artifacts (M8). The build-web/ tree mirrors build/ but
# is produced by `emcmake cmake -B build-web`. The Emscripten output
# (`EmberClash.html`, `EmberClash.js`, `EmberClash.wasm`, the .worker.js,
# any *.mem file) is rebuilt from sources on every run, so we don't
# keep it under version control. We DO keep the checked-in web shell
# under `web/` (the static `index.html` and any hand-written assets) -
# see the whitelist lines at the bottom of this block.
build-web/
*.html
*.wasm
*.mem
# Whitelist: any HTML / JS / CSS inside the checked-in web/ folder is
# allowed (and is the only place we keep .html / .js / .wasm sources).
!web/
!web/**/*.html
!web/**/*.js
!web/**/*.css
!web/**/*.wasm